# Native image for inventory-web-api (pure JSON gateway/BFF — no AWT, no fonts).
# Build the runner first:
#   mvn -pl inventory-web-api -am package -DskipTests -Dnative -Dquarkus.native.container-build=true
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work && chmod "g+rwX" /work && chown 1001:root /work
COPY --chown=1001:root target/*-runner /work/application
EXPOSE 8081
USER 1001
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
